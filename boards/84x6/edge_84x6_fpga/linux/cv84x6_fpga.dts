			cvi,codec_name = "dummy_codec";
			cvi,role = "slave";
			cvi,capture_only;
		};

		/* I2S1 Slave RX - receives SCLK/LRCK, captures data */
		dai@1 {
			cvi,dai_name = "i2s1-rx";
			cvi,stream_name = "i2s1-capture";
			cvi,cpu_dai_name = "29110000.i2s";
