#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/clock/cv84x6-clock.h>
#include <dt-bindings/reset/cv186x-resets.h>
#include <dt-bindings/dma/cv84x6-dmamap.h>

#include "cv84x6-pinctrl.dtsi"
#include "cv84x6-pcie.dtsi"

/ {
	compatible = "linux,dummy-virt";
	#size-cells = <0x2>;
	#address-cells = <0x2>;

	serial-number = "FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF";

	rst: reset-controller {
		#reset-cells = <1>;
		compatible = "cvitek,reset";
		reg = <0x0 0x28103000 0x0 0x10>;
	};

	osc: oscillator {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <25000000>;
		clock-output-names = "osc";
	};

	clk_rtc_32k: clk_rtc_32k {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <32768>;
		clock-output-names = "clk_rtc_32k";
	};

	rtc {
		compatible = "cvitek,rtc";
		reg = <0x0 0x05026000 0x0 0xF00>, <0x0 0x05025000 0x0 0x1000>;
	};

	usb_suspend_clk: usb_suspend_clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <200000>;
		clock-output-names = "usb_suspend_clk";
	};

	syscon: syscon@28100000 {
		compatible = "syscon", "simple-mfd";
		reg = <0x0 0x28100000 0x0 0x3000>;
	};

	clk: clock-controller {
		compatible = "cvitek,cv84x6-clk";
		clocks = <&osc>;
		#clock-cells = <1>;
		syscon = <&syscon>;
	};

#ifndef __UBOOT__
	cvitek-ion {
		compatible = "cvitek,cvitek-ion";

		ion_heap0: heap_carveout@0 {
			compatible = "cvitek,carveout_npu";
			memory-region = <&ion_for_npu>;
		};

		ion_heap1: heap_carveout@1 {
			compatible = "cvitek,carveout_vpp";
			memory-region = <&ion_for_vpp>;
		};
	};
#endif

	pclk: pclk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <25000000>;
	};

	otp: otp@27100000 {
                compatible = "sophon,secure-otp";
                reg = <0x0 0x27100000 0x0 0x4000>;
                #address-cells = <1>;
                #size-cells = <1>;
        };

	stmmac_axi_setup: stmmac-axi-config {
		snps,wr_osr_lmt = <1>;
		snps,rd_osr_lmt = <2>;
		snps,blen = <4 8 16 0 0 0 0>;
	};

	mtl_rx_setup: rx-queues-config {
		snps,rx-queues-to-use = <8>;
		queue0 {};
		queue1 {};
		queue2 {};
		queue3 {};
		queue4 {};
		queue5 {};
		queue6 {};
		queue7 {};
	};

	mtl_tx_setup: tx-queues-config {
		snps,tx-queues-to-use = <8>;
		queue0 {};
		queue1 {};
		queue2 {};
		queue3 {};
		queue4 {};
		queue5 {};
		queue6 {};
		queue7 {};
	};

	ethernet0: ethernet@290d0000 {
		compatible = "bitmain,ethernet";
		reg = <0x0 0x290d0000 0x0 0x4000>;
		reg-names = "mac";

		clock-names = "clk_tx", "stmmaceth", "ptp_ref";
		clocks = <&clk CV84X6_CLK_ETH0_TX>,
			   <&clk CV84X6_CLK_AXI4_ETH0>,
			   <&clk CV84X6_CLK_ETH0_PTP_REF>;
		// resets= <&rst RST_ETH0>;
		// reset-names = "stmmaceth";
#ifdef __UBOOT__
		phy-reset-gpios = <&porta 6 0>;
#endif
		/* no hash filter and perfect filter support */
		snps,multicast-filter-bins = <0>;
		snps,perfect-filter-entries = <1>;

		snps,txpbl = <32>;
		snps,rxpbl = <32>;
		snps,aal;

		snps,axi-config = <&stmmac_axi_setup>;
		snps,mtl-rx-config = <&mtl_rx_setup>;
		snps,mtl-tx-config = <&mtl_tx_setup>;

		phy-mode = "rgmii-id";
		//phy-mode = "rgmii_txid";

		status = "okay";
	};

	ethernet1: ethernet@290e0000 {
		compatible = "bitmain,ethernet";
		reg = <0x0 0x290e0000 0x0 0x4000>;
		reg-names = "mac";

		clock-names = "clk_tx", "stmmaceth", "ptp_ref";
		clocks = <&clk CV84X6_CLK_ETH1_TX>,
			   <&clk CV84X6_CLK_AXI4_ETH1>,
			   <&clk CV84X6_CLK_ETH1_PTP_REF>;
		// resets= <&rst RST_ETH0>;
		// reset-names = "stmmaceth";
#ifdef __UBOOT__
		phy-reset-gpios = <&porta 7 0>;
#endif
		/* no hash filter and perfect filter support */
		snps,multicast-filter-bins = <0>;
		snps,perfect-filter-entries = <1>;

		snps,txpbl = <32>;
		snps,rxpbl = <32>;
		snps,aal;

		snps,axi-config = <&stmmac_axi_setup>;
		snps,mtl-rx-config = <&mtl_rx_setup>;
		snps,mtl-tx-config = <&mtl_tx_setup>;

		phy-mode = "rgmii-id";
		//phy-mode = "rgmii_txid";

		status = "okay";
	};

	sysdma_remap0 {
		compatible = "cvitek,sysdma_remap";
		reg = <0x0 0x28100364 0x0 0x8>;

		ch-remap = <CVI_I2S0_RX CVI_I2S2_TX CVI_I2S1_RX CVI_I2S1_TX
					CVI_I2S_dw_RX CVI_I2S_dw_TX CVI_I2S2_RX CVI_I2S3_TX>;
	};

	dmac0: dma@0x29330000 {
		compatible = "snps,dmac-bm";
		reg = <0x0 0x29330000 0x0 0x1000>;
		clock-names = "clk_sdma_axi";
		clocks = <&clk CV84X6_CLK_AXI_SDMA0>;
		dma-channels = /bits/ 8 <8>;
		#dma-cells = <3>;
		dma-requests = /bits/ 8 <16>;
		chan_allocation_order = /bits/ 8 <0>;
		chan_priority = /bits/ 8 <1>;
		block_size = <1024>;
		dma-masters = /bits/ 8 <2>;
		data-width = <4 4>; /* bytes */
		axi_tr_width = <4>; /* bytes */
		block-ts = <15>;
	};

	sysdma_remap1 {
		compatible = "cvitek,sysdma_remap";
		reg = <0x0 0x2810036C 0x0 0x8>;
		ch-remap = <CVI_I2S4_RX CVI_SPI_NAND CVI_SPI_NAND CVI_I2S5_TX
					CVI_SPI0_RX CVI_SPI0_TX CVI_SPI1_RX CVI_SPI1_TX>;
	};

	dmac1: dma@0x29340000 {
		compatible = "snps,dmac-bm";
		reg = <0x0 0x29340000 0x0 0x1000>;
		clock-names = "clk_sdma_axi";
		clocks = <&clk CV84X6_CLK_AXI_SDMA1>;
		dma-channels = /bits/ 8 <8>;
		#dma-cells = <3>;
		dma-requests = /bits/ 8 <16>;
		chan_allocation_order = /bits/ 8 <0>;
		chan_priority = /bits/ 8 <1>;
		block_size = <1024>;
		dma-masters = /bits/ 8 <2>;
		data-width = <4 4>; /* bytes */
		axi_tr_width = <4>; /* bytes */
		block-ts = <15>;
	};

	spi0:spi@29200000 {
		compatible = "snps,dw-apb-ssi";
		reg = <0x0 0x29200000 0x0 0x10000>;
		clocks = <&clk CV84X6_CLK_SPI0>;
		#address-cells = <1>;
		#size-cells = <0>;
#if 0
		dmas = <&dmac1 4 1 1
			&dmac1 5 1 1>;
		dma-names = "rx", "tx";
		capability = "rxtx";
#endif
		status = "okay";
		num-cs = <1>;
		spidev@0 {
			compatible = "rohm,dh2228fv";
			spi-max-frequency = <1000000>;
			reg = <0>;
		};
	};

	spi1:spi@29210000 {
		compatible = "snps,dw-apb-ssi";
		reg = <0x0 0x29210000 0x0 0x10000>;
		clocks = <&clk CV84X6_CLK_SPI1>;
		#address-cells = <1>;
		#size-cells = <0>;
#if 0
		dmas = <&dmac1 6 1 1
			&dmac1 7 1 1>;
		dma-names = "rx", "tx";
		capability = "rxtx";
#endif
		status = "okay";
		num-cs = <1>;
		spidev@0 {
			compatible = "rohm,dh2228fv";
			spi-max-frequency = <1000000>;
			reg = <0>;
		};
	};

	spi2:spi@29220000 {
		compatible = "snps,dw-apb-ssi";
		reg = <0x0 0x29220000 0x0 0x10000>;
		clocks = <&clk CV84X6_CLK_SPI2>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
		num-cs = <1>;
		spidev@0 {
			compatible = "rohm,dh2228fv";
			spi-max-frequency = <1000000>;
			reg = <0>;
		};
	};

	spi3:spi@29230000 {
		compatible = "snps,dw-apb-ssi";
		reg = <0x0 0x29230000 0x0 0x10000>;
		clocks = <&clk CV84X6_CLK_SPI3>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
		num-cs = <1>;
		spidev@0 {
			compatible = "rohm,dh2228fv";
			spi-max-frequency = <1000000>;
			reg = <0>;
		};
	};

	i2c0: i2c@29000000 {
		compatible = "snps,designware-i2c";
		clocks = <&clk CV84X6_CLK_I2C0>;
		reg = <0x0 0x29000000 0x0 0x1000>;
		clock-frequency = <100000>;

		#size-cells = <0x0>;
		#address-cells = <0x1>;
		// resets = <&rst RST_I2C0>;
		// reset-names = "i2c0";

		pinctrl-names = "default";
		pinctrl-0 = <&i2c0_default>;

		rtc@68 {
			compatible = "dallas,ds1307";
			reg = <0x68>;
		};
	};

	i2s_mclk: i2s_mclk {
		clock-output-names = "i2s_mclk";
		clock-frequency = <24576000>;
		#clock-cells = <0x0>;
		compatible = "fixed-clock";
	};

	i2s_subsys: i2s_subsys {
		compatible = "cvitek,i2s_tdm_subsys";
		reg = <0x0 0x29100000 0x0 0x10000>;
		clocks = <&i2s_mclk>,
			<&clk CV84X6_CLK_AUD0>, <&clk CV84X6_CLK_AUD1>,
			<&clk CV84X6_CLK_AUD2>, <&clk CV84X6_CLK_AUD3>,
			<&clk CV84X6_CLK_AUD4>, <&clk CV84X6_CLK_AUD_HDMI>;

		clock-names = "i2sclk",
			"clk_aud0", "clk_aud1",
			"clk_aud2", "clk_aud3",
			"clk_aud4";
		master_base = <0x29110000>; /* I2S1 is master, only useful while using multi I2S IPs work on same IO */
	};

	i2s_hdmi: i2s_hdmi@290f0000 {
		compatible = "cvitek,cvitek-dwi2s-hdmi";
		reg = <0x0 0x290f0000 0x0 0x10000>,
		      <0x0 0x28102000 0x0 0x400>;
		clocks = <&clk CV84X6_CLK_AUD_HDMI>;
		clock-names = "hdmi_aud_clk";
		dev-id = <0>;
		#sound-dai-cells = <0>;
		dmas = <&dmac1 2 1 1>;
		dma-names = "tx";
		capability = "tx";
		mclk_out = "true";
		status = "okay";
	};

#ifndef __UBOOT__
	cv84x6_hdmi_audio: cv84x6-hdmi-audio {
		compatible = "cvitek,cv84x6-hdmi-audio";
		cvi,card_name = "cv84x6-hdmi";
		cvi,cpu_dai_name = "290f0000.i2s_hdmi";
		cvi,platform_name = "290f0000.i2s_hdmi";
		cvi,codec = <&hdmi>;
		status = "okay";
	};
#endif

	i2s0: i2s@29178000 {
		compatible = "cvitek,cvitek-dwi2s";
		reg = <0x0 0x29178000 0x0 0x400>;
		clocks = <&i2s_mclk 0>;
		clock-names = "i2sclk";

		dev-id = <6>;
		#sound-dai-cells = <0>;
		dmas = <&dmac0 0 1 1    /* read channel */
				&dmac0 1 1 1>;  /* write channel */
		dma-names = "rx","tx";
		capability = "txrx"; /* I2S0 connect to internal ADC as RX */
		mclk_out = "true";

		pinctrl-names = "default";
		pinctrl-0 = <&i2s0_default>;
	};

	i2s1: i2s@29110000 {
		compatible = "cvitek,cv1835-i2s";
		reg = <0x0 0x29110000 0x0 0x10000>;
		clocks = <&i2s_mclk 0>;
		clock-names = "i2sclk";

		dev-id = <0>;
		#sound-dai-cells = <0>;
		dmas = <&dmac0 2 1 1>; /* CVI_I2S1_RX=2, sysdma_remap0 ch2 (Case A reversed) */
		dma-names = "rx";
		capability = "rx"; /* Case A reversed: IIS1 slave RX <- IIS2 master TX */
		mclk_out = "false";

		pinctrl-names = "default";
		pinctrl-0 = <&i2s1_default>;
	};

	i2s2: i2s@29120000 {
		compatible = "cvitek,cv1835-i2s";
		reg = <0x0 0x29120000 0x0 0x10000>;
		clocks = <&i2s_mclk 0>;
		clock-names = "i2sclk";

		dev-id = <1>;
		#sound-dai-cells = <0>;
		dmas = <&dmac0 3 1 1>; /* CVI_I2S2_TX=5, sysdma_remap0 ch3 (Case A reversed) */
		dma-names = "tx";
		capability = "tx"; /* Case A reversed: IIS2 master TX -> IIS1 slave RX */
		mclk_out = "true";
	};

	i2s3: i2s@29130000 {
		compatible = "cvitek,cv1835-i2s";
		reg = <0x0 0x29130000 0x0 0x10000>;
		clocks = <&i2s_mclk 0>;
		clock-names = "i2sclk";

		dev-id = <2>;
		#sound-dai-cells = <0>;
		dmas = <&dmac0 4 1 1>; /* write channel */
		dma-names = "tx";
		capability = "tx"; /* Case B: IIS3 slave TX <- IIS4 master RX (internal loopback) */
		mclk_out = "false";
	};

	i2s4: i2s@29140000 {
		compatible = "cvitek,cv1835-i2s";
		reg = <0x0 0x29140000 0x0 0x10000>;
		clocks = <&i2s_mclk 0>;
		clock-names = "i2sclk";

		dev-id = <3>;
		#sound-dai-cells = <0>;
		dmas = <&dmac1 0 1 1>; /* read channel: dmac1 ch0 = CVI_I2S4_RX per sysdma_remap1 */
		dma-names = "rx";
		capability = "rx"; /* Case B: IIS4 master RX -> IIS3 slave TX (internal loopback, duplex variant: 0x70/0x74) */
		mclk_out = "true";
	};

	sound_ext2 {
		compatible = "cvitek,cv186x-adau1372";
		cvi,model = "CV1835";
		cvi,mode = "I2S";
		cvi,fmt = "NBNF";
		cvi,card_name = "cvi_cv186x_dw";
		cvi,slot_no=<2>;

		dai@0 {
			cvi,stream_name = "adau1372-aif";
			cvi,role = "master";
		};
	};

	/* Case A: IIS1 master TX + IIS2 slave RX, IIS1 PAD SDO<->SDI externally shorted */
	sound_iis12_loopback {
		compatible = "cvitek,cv1835-dummy-card";
		cvi,model = "CV1835";
		cvi,mode = "I2S";
		cvi,fmt = "IBNF";
		cvi,card_name = "iis12_loopback";
		cvi,slot_no = <2>;
		status = "okay"; /* Case A: IIS1/2 external pad loopback */

		/* audio_sys mux: IIS1 (tdm_0) slave RX takes SCLK/FS/SDI from IIS2 (tdm_1) master TX.
		 * X2 audio_sys mux only supports "from next IIS(N+1)" routing, so Case A direction
		 * is reversed: IIS2 master TX → IIS1 slave RX (cv84x2 bmtest line 1528 reference).
		 * tdm_0[1:0]=01 for SCLK/FS, tdm_1[3:2]=01 for SDI. */
		cvi,loopback-mux = <&i2s_subsys
			0x00 0xFF 0x01   /* SCLK_IN_SEL: tdm_0=01 <- IIS2 bclk_out */
			0x04 0xFF 0x01   /* FS_IN_SEL:   tdm_0=01 <- IIS2 ws_lrck_fs_out */
			0x08 0xFF 0x01   /* SDI_IN_SEL:  tdm_1=01 <- IIS2 sdo (IIS1 SDI from IIS2 SDO, from-next routing) */
			0x0C 0xFF 0x00   /* SDO_OUT_SEL: no pad output needed */
			0x30 0xFF 0x00   /* BCLK_OEN_SEL: internal oen */>;

		/* IIS2 master TX (reversed: was IIS1 master TX) */
		dai@0 {
			cvi,dai_name = "i2s2-tx";
			cvi,stream_name = "iis2-playback";
			cvi,cpu_dai_name = "29120000.i2s";
			cvi,codec_dai_name = "dummy_codec-aif.0";
			cvi,platform_name = "29120000.i2s";
			cvi,codec_name = "dummy_codec.0";
			cvi,role = "master";
			cvi,playback_only;
		};

		/* IIS1 slave RX (reversed: was IIS2 slave RX) */
		dai@1 {
			cvi,dai_name = "i2s1-rx";
			cvi,stream_name = "iis1-capture";
			cvi,cpu_dai_name = "29110000.i2s";
			cvi,codec_dai_name = "dummy_codec-aif.0";
			cvi,platform_name = "29110000.i2s";
			cvi,codec_name = "dummy_codec.0";
			cvi,role = "slave";
			cvi,capture_only;
		};
	};

	/* Case B reversed: IIS3 master TX + IIS4 slave RX, fully internal (no pad) */
	sound_iis34_loopback {
		compatible = "cvitek,cv1835-dummy-card";
		cvi,model = "CV1835";
		cvi,mode = "I2S";
		cvi,fmt = "IBNF";
		cvi,card_name = "iis34_loopback";
		cvi,slot_no = <2>;
		status = "okay"; /* Case B: IIS3 slave TX <- IIS4 master RX (internal loopback) */

		/* audio_sys mux: tdm_3 takes tdm_4 bclk/ws; tdm_4 sdi <- tdm_3 sdo; no pad */
		cvi,loopback-mux = <&i2s_subsys
			0x00 0x30 0x30   /* i2s_tdm_sclk_in_sel: tdm_3[5:4]=11 <- tdm_4 bclk_out */
			0x04 0x30 0x30   /* i2s_tdm_fs_in_sel:   tdm_3[5:4]=11 <- tdm_4 ws_lrck */
			0x08 0xC0 0xC0   /* i2s_tdm_sdi_in_sel:  tdm_4[7:6]=11 <- tdm_3 sdo */
			0x0C 0xFF 0x00   /* i2s_tdm_sdo_out_sel: no pad output */
			0x20 0xFF 0x00   /* i2s_tdm_multi_sync0 */
			0x24 0xFF 0x00   /* i2s_tdm_multi_sync1 */>;

		/* IIS3 slave TX */
		dai@0 {
			cvi,dai_name = "i2s3-tx";
			cvi,stream_name = "iis3-playback";
			cvi,cpu_dai_name = "29130000.i2s";
			cvi,codec_dai_name = "dummy_codec-aif.1";
			cvi,platform_name = "29130000.i2s";
			cvi,codec_name = "dummy_codec.1";
			cvi,role = "slave";
			cvi,playback_only;
		};

		/* IIS4 master RX */
		dai@1 {
			cvi,dai_name = "i2s4-rx";
			cvi,stream_name = "iis4-capture";
			cvi,cpu_dai_name = "29140000.i2s";
			cvi,codec_dai_name = "dummy_codec-aif.1";
			cvi,platform_name = "29140000.i2s";
			cvi,codec_name = "dummy_codec.1";
			cvi,role = "master";
			cvi,capture_only;
		};
	};

	sound_ext1 {
		compatible = "cvitek,cv1835-adau1372";
		cvi,model = "CV1835";
		cvi,mode = "I2S";
		cvi,fmt = "IBNF";
		cvi,card_name = "cvi_sound_card_0";
		cvi,slot_no=<2>;
		status = "disabled"; /* conflicts with sound_iis12_loopback (IIS1) and sound_iis34_loopback (IIS3) */

		dai@0 {
			cvi,dai_name = "cv1835-i2s-3";
			cvi,stream_name = "adau1372-aif";
			cvi,cpu_dai_name = "29130000.i2s";
			cvi,codec_dai_name = "adau1372-aif";
			cvi,platform_name = "29130000.i2s";
			cvi,codec_name = "adau1372.0-003c";
			cvi,role = "slave";
			cvi,capture_only;
		};

		dai@1 {
			cvi,dai_name = "cv1835-i2s-1";
			cvi,stream_name = "adau1372-aif";
			cvi,cpu_dai_name = "29110000.i2s";
			cvi,codec_dai_name = "adau1372-aif";
			cvi,platform_name = "29110000.i2s";
			cvi,codec_name = "adau1372.0-003c";
			cvi,role = "master";
			cvi,playback_only;
		};
	};

	i2c1: i2c@29010000 {
		compatible = "snps,designware-i2c";
		clocks = <&clk CV84X6_CLK_I2C1>;
		reg = <0x0 0x29010000 0x0 0x1000>;
		clock-frequency = <400000>;

		#size-cells = <0x0>;
		#address-cells = <0x1>;
		// resets = <&rst RST_I2C1>;
		// reset-names = "i2c1";
	};

	i2c2: i2c@29020000 {
		compatible = "snps,designware-i2c";
		clocks = <&clk CV84X6_CLK_I2C2>;
		reg = <0x0 0x29020000 0x0 0x1000>;
		clock-frequency = <100000>;

		#size-cells = <0x0>;
		#address-cells = <0x1>;
		// resets = <&rst RST_I2C2>;
		// reset-names = "i2c2";
	};

