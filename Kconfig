	string
	default "" if STORAGE_TYPE_none
	default "emmc" if STORAGE_TYPE_emmc
	default "spinand" if STORAGE_TYPE_spinand
	default "spinor" if STORAGE_TYPE_spinor
	default "sd" if STORAGE_TYPE_sd

