config ALIOS_SOLUTION
    string # "Solution in AliOS"
    depends on ENABLE_ALIOS
    default "normboot" if NORM_SOLUTION
    default "fastboot" if FAST_SOLUTION
    help
        Don't change this value, if you don't know how to run it.
        "normboot" - The default value for general use.
        "fastboot" - Designed for fast boot of media in special scenarios, such as the fastboot test.

config MEDIA_SUPPORT_PROC
    bool "Media Proc Support"
    depends on ENABLE_ALIOS
    default y
    help
        If set to "y", some media modules' proc commands will be enabled in AliOS.
        If set to "n", some media modules' proc commands will be disabled in AliOS.

config RTOS_INIT_MEDIA
    bool "Automatically Initialize Media in RTOS"
    depends on ENABLE_ALIOS
    default n
    help
        If set to "y", the media will be automatically initialized by RTOS.
        If set to "n", the media should be initialized in applications on Linux.

config RTOS_PARSE_PARAM
    bool "Parse Params in RTOS"
    depends on ENABLE_ALIOS && RTOS_INIT_MEDIA
    default n
    help
        If set to "y", the RTOS will parse parameters from the param.bin file.
        If set to "n", the RTOS will use the default parameters.

choice
    prompt "Alios uart in dualos"
    default DW_UART

config DW_UART
        bool "Enable dw uart"
        depends on ENABLE_ALIOS
        help
          set enable dw uart in Dualos.

config VIRTUAL_UART
        bool "Enable virtual uart"
        depends on ENABLE_ALIOS
        help
          set enable virtual uart in Dualos.

endchoice

config MIRROR_2ND_PACK_HEAD
        bool "Update second mirror image with 128 byte headers"
        depends on ENABLE_ALIOS
        default n
        help
          set alios with 128 byte headers update to storage.

config RTOS_BUILD_IN_FIP
        bool "RTOS image build in to fip.bin"
        default y
        help
          select the rtos imgae build in to fip.bin or not.
          default is "y"
          If set to "y", the rtos image is build in to fip.bin.
          If set to "n", the rtos image is not build in to fip.bin.
		  If it's not set, it is same as "n"

choice
	prompt "Rtos Image Compression Type"
	default RTOS_COMPRESS_LZMA if ENABLE_ALIOS
	default RTOS_COMPRESS_ORIG if ENABLE_FREERTOS
	default RTOS_COMPRESS_ORIG if ENABLE_RTT
	help
		when ENABLE_FREERTOS=y, compression type is forced to "orig"

	config RTOS_COMPRESS_ORIG
	bool "orig"
	config RTOS_COMPRESS_LZMA
        depends on !(ENABLE_FREERTOS|| ENABLE_RTT)
	bool "lzma"
	config RTOS_COMPRESS_LZ4
        depends on !(ENABLE_FREERTOS|| ENABLE_RTT)
	bool "lz4"
endchoice

config RTOS_COMPRESS_TYPE
	string
	default "orig" if RTOS_COMPRESS_ORIG
	default "lzma" if RTOS_COMPRESS_LZMA
	default "lz4" if RTOS_COMPRESS_LZ4
	help
		Select the RTOS image compress type
		default compress type is "lzma"
		The choices of compress type are "lz4" and "lzma" or "orig"

source "output/Kconfig.pipelines"

endmenu

