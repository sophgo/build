    bool "none"
  config STORAGE_TYPE_emmc
    bool "emmc"
  select TARGET_PACKAGE_E2FSPROGS
  config STORAGE_TYPE_spinand
    bool "spinand"
  select TARGET_PACKAGE_MTD-UTILS
  config STORAGE_TYPE_spinor
    bool "spinor"
  config STORAGE_TYPE_sd
    bool "sd"
endchoice

