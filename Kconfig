	string
	default "glibc_arm64" if TOOLCHAIN_GLIBC_ARM64
	default "glibc_arm" if TOOLCHAIN_GLIBC_ARM
	default "musl_arm" if TOOLCHAIN_MUSL_ARM
	default "musl_arm64" if TOOLCHAIN_MUSL_ARM64
	default "glibc_riscv64" if TOOLCHAIN_GLIBC_RISCV64
	default "musl_riscv64" if TOOLCHAIN_MUSL_RISCV64
	help
	  Set sdk version.

config STATIC
	bool "Build static binary (no shared libs)"
	default n
	help
	  If you want to build a static binary, which does not use
	  or require any shared libraries, enable this option.
	  Static binaries are larger, but do not require functioning
	  dynamic libraries to be present, which is important if used
	  as a system rescue tool.

config SWITCH_32K_XTAL
	bool "SWITCH 32K to external XTAL"
	default n
	help
	  If you wish to use the on-board 32k crystal oscillator
	  instead of the internal 32k clock of rtc_sys, please
	  enable this feature. Once enabled, the BL2 code in the
	  FSBL repository will perform the 32k clock source switching.


config BUILD_FOR_DEBUG
	bool "Build SDK with debug config"
	default y
	help
	  This configuration is only valid for uboot and kernel.
	  If you want to build SDK for release,please set BUILD_FOR_DEBUG=n.
	  "y":build kernel with DEBUG config(such as CONFIG_DEBUG_FS,CONFIG_DEBUG_INFO)
	      build uboot with commands(such as 'ping','echo','tftp').
	  "n":build kernel with release config(disable CONFIG_DEBUG_FS and so on)
	      build uboot without commands.

config FASTBOOT_GENERAL
	bool "Build SDK with general fastboot options"
	default n
	depends on !BUILD_FOR_DEBUG && DUAL_OS
	select FASTBOOT if FASTBOOT_GENERAL
	select UBOOT_SPL_CUSTOM if FASTBOOT_GENERAL
	select BOOT_TIME_OPTIMIZATION if FASTBOOT_GENERAL
	select OSDRV_BUILD_IN if FASTBOOT_GENERAL
	help
		This enables general features for fastboot. If you don't know how to customize
		your fastboot SDK, this option give you some common fastboot choices here.
		But, if you know how to customize your fastboot configuration, please set n.

config FASTBOOT
	bool "Fast boot"
	default n
	depends on !BUILD_FOR_DEBUG && DUAL_OS
	help
		This enables fast boot features.
		1. activate linux funtion controlled by __FASTBOOT__
		2. store *.ko in data folder to shrink rootfs
		3. use shrink rootfs
		4. defer init linux components
		5. use simplipied busybox

