<!-- 
  物理分区配置说明
  - 每个扇区(sector)大小为 512 bytes
  - 出厂表总容量：58,690,849 sectors × 512 = 30,049,714,688 bytes（约 28 GB）
  - DATA 先给 4GB，首次启动由 resize-helper 按实际 eMMC 扩到盘尾
  - GPT last_usable_lba = size_in_sectors - 34，必须小于等于 eMMC 实际扇区数

  分区布局（首分区从 LBA 8192 开始）：
  BOOT_A/BOOT_B:       262,144 sectors × 512 = 128 MB
  ENV:                     512 sectors × 512 = 256 KB
  MISC:                 20,480 sectors × 512 = 10 MB
  ROOTFS_A/ROOTFS_B: 6,291,456 sectors × 512 = 3 GB
  ROOTFS_RW_A/B:    18,582,912 sectors × 512 = 8.86 GB
  DATA:              8,388,608 sectors × 512 = 4 GB

  文件系统格式说明：
  "0" - 原始格式/无文件系统
  "1" - FAT32文件系统
  "2" - EXT4文件系统
  DATA 起始位置 = 8192 + 262144*2 + 512 + 20480 + 6291456*2 + 18582912*2 = 50302208
-->

<physical_partition size_in_sectors="58690849">
        <partition label="BOOT_A"       size_in_sectors="262144"   readonly="false"  format="1" />
	<partition label="BOOT_B"       size_in_sectors="262144"   readonly="false"  format="1" />
        <partition label="ENV"          size_in_sectors="512"      readonly="false"  format="0" />
        <partition label="MISC"         size_in_sectors="20480"    readonly="false"  format="0" />
        <partition label="ROOTFS_A"     size_in_sectors="6291456"  readonly="true"   format="2" />
	<partition label="ROOTFS_B"     size_in_sectors="6291456"  readonly="true"   format="2" />
        <partition label="ROOTFS_RW_A"  size_in_sectors="18582912" readonly="false"  format="2" />
	<partition label="ROOTFS_RW_B"  size_in_sectors="18582912" readonly="false"  format="2" />
        <partition label="DATA"         size_in_sectors="8388608"  readonly="false"  format="2" />
</physical_partition>
